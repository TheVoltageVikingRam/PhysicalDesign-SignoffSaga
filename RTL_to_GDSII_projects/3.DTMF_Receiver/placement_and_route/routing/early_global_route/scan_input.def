###############################################################

VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN DTMF_CHIP ;
UNITS DISTANCE MICRONS 2000 ;

PROPERTYDEFINITIONS
    COMPONENETPIN designRuleWidth REAL ;
    DESIGN FE_CORE_BOX_LL_X REAL 335.280 ;
    DESIGN FE_CORE_BOX_UR_X REAL 1176.960 ;
    DESIGN FE_CORE_BOX_LL_Y REAL 335.440 ;
    DESIGN FE_CORE_BOX_UR_Y REAL 1177.120 ;
END PROPERTYDEFINITIONS

DIEAREA ( 0 0 ) ( 3023930 3024240 ) ;

SCANCHAINS 2 ;
- scan2
 + START PIN scan_in_2 
 + FLOATING
    